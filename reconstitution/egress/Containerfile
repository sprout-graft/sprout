# Egress-filter sidecar for the reconstituted Sprout.
# A minimal squid forward proxy with a domain allowlist, built from a
# distribution package (no third-party images). See RUNBOOK.md §5.
#
# Build:  podman build -t sprout-egress -f reconstitution/egress/Containerfile reconstitution/egress

FROM debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends squid \
 && rm -rf /var/lib/apt/lists/*

COPY squid.conf /etc/squid/squid.conf

EXPOSE 3128
CMD ["squid", "-N", "-d", "1"]
